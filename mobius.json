{
  "id": "contribute",
  "name": "Contribute",
  "version": "0.5.44",
  "description": "See local project changes, prepare and review them privately, and follow shared work through acceptance.",
  "author": "mobius-os",
  "license": "MIT",
  "homepage": "https://github.com/mobius-os/app-contribute",
  "icon": "icon.png",
  "entry": "index.jsx",
  "offline_capable": true,
  "embeds_agent": true,
  "capabilities": {
    "chat.blocks.passive": {
      "version": 1,
      "reason": "Shows the current state of the contributions a chat card names, and sends them to GitHub only after you press Confirm on that card."
    }
  },
  "offline": {
    "reads": true,
    "writes": "none",
    "execution": "none"
  },
  "permissions": {
    "cross_app_access": "none",
    "share_with_apps": "none",
    "github_access": true,
    "github_connect": true
  },
  "runtime": {
    "imports": [
      "react",
      "react-dom",
      "marked",
      "dompurify",
      "@openai/apps-sdk-ui/components/Icon"
    ],
    "esm_deps": []
  },
  "schedule": {
    "default": "*/15 * * * *",
    "job": "job.sh"
  },
  "service": {
    "entry": "service.py",
    "access": "self"
  },
  "skills": [
    "contributing/",
    "review-followup.md"
  ],
